@page "/sensors"
@implements IAsyncDisposable
@using Sensor3.Contracts
@inject IServiceProvider Services
<h1>Native sensorinsamling</h1>
@if (Provider is null)
{
    <p>Sensorinsamling finns i Android- och Windows-appen. Webbläsaren samlar inga rörelsesensorer.</p>
}
else
{
    <p>Välj sensorer och starta en mätning. Värden kommer från enhetens operativsystem. Insamling stoppas när appen går till bakgrunden eller sidan lämnas.</p>
    <label>Önskad frekvens (1–200 Hz) <input type="number" min="1" max="200" step="1" @bind="frequency" disabled="@(busy || Provider.IsRunning)" /></label>
    <button disabled="@(busy || Provider.IsRunning)" @onclick="Discover">Inventera</button>
    <button disabled="@(busy || Provider.IsRunning || selected.Count == 0)" @onclick="Start">Starta</button>
    <button disabled="@(busy || !Provider.IsRunning)" @onclick="Stop">Stoppa</button>
    @if (PermissionService is not null)
    {
        <button disabled="@(busy || Provider.IsRunning || selected.Count == 0)" @onclick="RequestPermissions">Begär behörighet för valda sensorer</button>
    }
    <p role="status">@message</p>
    <p>Samplingsfrekvensen är en begäran till operativsystemet. Faktisk frekvens visas efter minst två giltiga värden. Värden från olika koordinatsystem har inte roterats till en gemensam referensram.</p>
    <table><thead><tr><th>Välj</th><th>Sensor / typ</th><th>Status</th><th>Senaste mätvärde</th><th>Faktisk Hz / antal</th></tr></thead><tbody>
    @foreach (var sensor in catalogue)
    {
        var stat = Provider.GetStatistics().FirstOrDefault(x => x.SensorId == sensor.Id);
        <tr>
            <td><input type="checkbox" aria-label="@($"Välj {sensor.Name}")" checked="@selected.Contains(sensor.Id)" disabled="@(busy || Provider.IsRunning || sensor.Status is not (SensorStatus.Available or SensorStatus.PermissionRequired))" @onchange="e => Select(sensor.Id, e.Value is true)" /></td>
            <td>@sensor.Name<br />@sensor.Kind</td>
            <td>@(states.GetValueOrDefault(sensor.Id)?.Status ?? sensor.Status)<br />@(states.GetValueOrDefault(sensor.Id)?.Detail ?? sensor.Detail)</td>
            <td>@if (latest.TryGetValue(sensor.Id, out var reading)) {
                <span>@string.Join("; ", reading.Values.Select(x => $"{x.Name}={x.Value:G6} {x.Unit}"))</span><br />
                <span>Tidskälla: @reading.TimestampSource · kvalitet: @reading.Quality</span><br />
                <span>@(reading.MonotonicTimestampNanoseconds?.ToString() ?? reading.TimestampUtc?.ToString("O"))</span>
            } else { <span>Inga mätvärden</span> }</td>
            <td>@(stat?.ActualFrequencyHz?.ToString("F2") ?? "Unknown") / @(stat?.ReceivedCount ?? 0)<br />Avvisade: @(stat?.RejectedCount ?? 0)</td>
        </tr>
    }
    </tbody></table>
}
@code {
    private ISensorProvider? Provider => Services.GetService(typeof(ISensorProvider)) as ISensorProvider;
    private ISensorPermissionService? PermissionService => Services.GetService(typeof(ISensorPermissionService)) as ISensorPermissionService;
    private IReadOnlyList<SensorDescriptor> catalogue = [];
    private readonly HashSet<string> selected = [];
    private readonly Dictionary<string, SensorReading> latest = [];
    private readonly Dictionary<string, SensorState> states = [];
    private double frequency = 50;
    private bool busy;
    private volatile bool disposed;
    private string message = "Inte startad";
    private System.Threading.Timer? refresh;
    private readonly System.Collections.Concurrent.ConcurrentDictionary<string, SensorReading> pending = new();
    protected override async Task OnInitializedAsync()
    {
        if (Provider is null) return;
        Provider.ReadingReceived += Reading;
        Provider.StateChanged += State;
        refresh = new(_ => { if (!disposed) _ = InvokeAsync(Refresh); }, null, 200, 200);
        await Discover();
    }
    private void Reading(SensorReading reading) { if (!disposed) pending[reading.SensorId] = reading; }
    private void State(SensorState state) { if (!disposed) _ = InvokeAsync(() => { if (!disposed) { states[state.SensorId] = state; if (state.Status == SensorStatus.Stopped && Provider?.IsRunning == false) message = "Insamling stoppad"; StateHasChanged(); } }); }
    private void Refresh() { if (disposed) return; foreach (var (id, reading) in pending) { if (pending.TryRemove(id, out var value)) latest[id] = value; } StateHasChanged(); }
    private void Select(string id, bool value) { if (value) selected.Add(id); else selected.Remove(id); }
    private Task Discover() => Run(async () => { catalogue = await Provider!.DiscoverAsync(); selected.Clear(); latest.Clear(); states.Clear(); pending.Clear(); message = "Inventering klar. Välj sensorer för att samla mätvärden."; });
    private Task Start() => Run(async () => { latest.Clear(); states.Clear(); pending.Clear(); await Provider!.StartAsync(selected.ToArray(), new() { FrequencyHz = frequency }); message = "Insamling pågår"; });
    private Task Stop() => Run(async () => { await Provider!.StopAsync(); message = "Insamling stoppad"; });
    private Task RequestPermissions() => Run(async () => { await PermissionService!.RequestAsync(catalogue.Where(x => selected.Contains(x.Id)).ToArray()); catalogue = await Provider!.DiscoverAsync(); message = "Behörighetskontroll klar. Nekade sensorer kan inte startas."; });
    private async Task Run(Func<Task> action)
    {
        busy = true;
        try { await action(); }
        catch (Exception exception) { message = "Insamling stoppad: " + exception.Message; }
        finally { busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (refresh is not null) await refresh.DisposeAsync();
        if (Provider is null) return;
        Provider.ReadingReceived -= Reading; Provider.StateChanged -= State;
        await Provider.StopAsync();
    }
}
