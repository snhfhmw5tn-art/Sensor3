<Project>
  <!-- VS can supply empty/stale global SDK properties after project evaluation. -->
  <Target Name="ResolveSensor3AndroidSdkPaths" BeforeTargets="_ResolveSdks" Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <PropertyGroup>
      <_Sensor3LocalAppData>$([System.Environment]::GetFolderPath(System.Environment+SpecialFolder.LocalApplicationData))</_Sensor3LocalAppData>
      <AndroidSdkDirectory Condition="!Exists('$(AndroidSdkDirectory)\platform-tools\adb.exe') and Exists('$(_Sensor3LocalAppData)\Android\Sdk\platform-tools\adb.exe')">$(_Sensor3LocalAppData)\Android\Sdk</AndroidSdkDirectory>
      <JavaSdkDirectory Condition="!Exists('$(JavaSdkDirectory)\bin\java.exe') and Exists('$(_Sensor3LocalAppData)\Microsoft\Jdk\bin\java.exe')">$(_Sensor3LocalAppData)\Microsoft\Jdk</JavaSdkDirectory>
    </PropertyGroup>
  </Target>
  <PropertyGroup><Sensor3BuildNumber Condition="'$(Sensor3BuildNumber)' == ''">8</Sensor3BuildNumber><Sensor3ReleaseChannel Condition="'$(Sensor3ReleaseChannel)' == ''">Development</Sensor3ReleaseChannel></PropertyGroup>
  <Target Name="GenerateSensor3BuildInfo" BeforeTargets="AssignTargetPaths" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)tools\Generate-BuildInfo.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)build-info.json&quot; -Platform &quot;$(TargetFramework)&quot; -Version &quot;$(Version)&quot; -BuildNumber &quot;$(Sensor3BuildNumber)&quot; -ReleaseChannel &quot;$(Sensor3ReleaseChannel)&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)build-info.json" LogicalName="Sensor3.BuildInfo.json" />
      <EmbeddedResource Include="$(MSBuildThisFileDirectory)iterations.json" LogicalName="Sensor3.Iterations.json" />
    </ItemGroup>
  </Target>
</Project>
