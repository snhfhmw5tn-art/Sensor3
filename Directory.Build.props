<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Version>0.18.0</Version>
    <!-- Visual Studio may retain older environment variables until restarted. -->
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LocalAppData)\Android\Sdk\platform-tools\adb.exe')">$(LocalAppData)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(LocalAppData)\Microsoft\Jdk\bin\java.exe')">$(LocalAppData)\Microsoft\Jdk</JavaSdkDirectory>
  </PropertyGroup>
</Project>
